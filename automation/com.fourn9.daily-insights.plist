<?xml version="1.0" encoding="UTF-8"?>
<!-- 毎日 19:00（Mac のローカル時刻＝JST 前提）に run-daily-insights.sh を実行する launchd エージェント。
     設置: ~/Library/LaunchAgents/com.fourn9.daily-insights.plist にコピーして
     launchctl load してください（手順は automation/README.md）。 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.fourn9.daily-insights</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>$HOME/Desktop/Findy/Claude/iroiro/daily-insights/automation/run-daily-insights.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>19</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/tmp/daily-insights.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/daily-insights.err.log</string>
</dict>
</plist>
